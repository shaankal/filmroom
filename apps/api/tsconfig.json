{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "outDir": "dist",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@filmroom/types": ["../../packages/types/src/index.ts"],
      "@filmroom/types/*": ["../../packages/types/src/*"]
    }
  },
  "include": ["src/**/*", "../../packages/types/src/**/*"]
}
